---
import { cv } from '../data/cv';
import { displayUrl } from '../lib/cv-helpers';
const rows = [
  ['Email', `mailto:${cv.contact.email}`, cv.contact.email],
  ['LinkedIn', cv.contact.linkedin.href, displayUrl(cv.contact.linkedin.href)],
  ['GitHub', cv.contact.github.href, displayUrl(cv.contact.github.href)],
] as const;
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container section-grid">
    <div class="section-head">
      <h2 id="contact-title">Contact</h2>
      <p>{cv.person.availability}</p>
    </div>
    <div>
      <dl class="contact-links">
        {
          rows.map(([label, href, text]) => (
            <div class="contact-line">
              <dt>{label}</dt>
              <dd>
                <a href={href}>{text}</a>
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="cta-row" style="margin-top:var(--s-6)">
        <a class="btn btn-primary" href={`/${cv.site.pdfFile}`} download>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"></path></svg>
          Download CV (PDF)
        </a>
      </div>
    </div>
  </div>
</section>
