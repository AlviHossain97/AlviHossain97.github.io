---
import { cv } from '../data/cv';
const edu = cv.entries.filter((e) => e.kind === 'education').sort((a, b) => (b.sort ?? 0) - (a.sort ?? 0));
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="container">
    <div class="section-head">
      <h2 id="education-title">Education</h2>
    </div>
    <div class="edu-grid">
      {edu.map((e) => (
        <article class="edu spot" id={`edu-${e.id}`} data-reveal>
          <h3>{e.title}</h3>
          <p class="org">{e.org}</p>
          <p class="period mono">{e.period}</p>
          {e.modules.length > 0 && (
            <details class="modules">
              <summary>
                Modules included
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <ul class="tags">
                {e.modules.map((m) => (
                  <li>
                    <span class="tag">{m}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </article>
      ))}
    </div>
    <p class="edu-note">{cv.notes.join(' ')}</p>
  </div>
</section>
