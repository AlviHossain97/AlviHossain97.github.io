---
import ArchDiagram from './ArchDiagram.astro';
import { cv } from '../data/cv';
import { diagrams } from '../data/diagrams';
import { orgLine, tagsFor } from '../lib/cv-helpers';

// Featured order as briefed: LearnThrive platform, Cirquon, PiStation.
const order = ['learnthrive-platform', 'cirquon', 'pistation'];
const featured = cv.entries.filter((e) => e.kind === 'project' && e.featured);
featured.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
if (featured.some((e) => !order.includes(e.id)))
  throw new Error('Projects.astro: every featured project must be listed in `order`');
const diagramFor = (id: string) => {
  const d = diagrams.find((x) => x.id === id);
  if (!d) throw new Error(`Projects.astro: no diagram for featured project ${id}`);
  return d;
};
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
      <p>Three projects in depth. The smaller university projects are on the timeline.</p>
    </div>
    <div class="cases">
      {featured.map((e) => {
        const hasMore = Boolean(e.role || e.outcome || e.highlights.length || e.links.length);
        return (
          <article class="case" id={`case-${e.id}`} data-reveal>
            <div class="case-text">
              <div class="case-head">
                <h3>{e.title}</h3>
                <p class="case-sub">
                  {orgLine(e)}
                  {e.period ? <span class="mono"> · {e.period}</span> : null}
                </p>
              </div>
              <p class="case-sum">{e.summary}</p>
              <ul class="tags" aria-label="Skills and tools">
                {tagsFor(e).map((t) => (
                  <li>
                    {t.skillId ? (
                      <a class="tag" href={`#skill-${t.skillId}`}>
                        {t.label}
                      </a>
                    ) : (
                      <span class="tag">{t.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
            <ArchDiagram diagram={diagramFor(e.id)} />
            {hasMore && (
              <details>
                <summary>
                  More detail
                  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <dl class="case-more">
                  {e.role && (
                    <div>
                      <dt>My role</dt>
                      <dd>{e.role}</dd>
                    </div>
                  )}
                  {e.outcome && (
                    <div>
                      <dt>Outcome</dt>
                      <dd>{e.outcome}</dd>
                    </div>
                  )}
                </dl>
                {e.highlights.length > 0 && (
                  <ul class="bullets" style="margin-top:var(--s-4)">
                    {e.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
                {e.links.length > 0 && (
                  <div class="link-row" style="margin-top:var(--s-4)">
                    {e.links.map((l) => (
                      <a class="text-link" href={l.href}>
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </details>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Deep links: #case-<id> opens that case study's detail and scrolls to it, even when the hash is already set.
  import { readHash } from '../lib/hash';
  const open = (id: string) => {
    const el = document.getElementById(id);
    if (!el?.matches('.case')) return;
    el.querySelector('details')?.setAttribute('open', '');
    el.scrollIntoView({ block: 'start' });
  };
  addEventListener('hashchange', () => open(readHash()));
  document.addEventListener('click', (ev) => {
    const a = (ev.target as Element | null)?.closest?.('a[href^="#case-"]');
    if (!a || ev.defaultPrevented || ev.metaKey || ev.ctrlKey) return;
    queueMicrotask(() => open(a.getAttribute('href')!.slice(1)));
  });
  open(readHash());
</script>
