---
import { cv } from '../data/cv';
import { orgLine, tagsFor } from '../lib/cv-helpers';

const featured = cv.entries.filter((e) => e.kind === 'project' && e.featured);
const others = cv.entries.filter((e) => e.kind === 'project' && !e.featured);
// Featured order as briefed: LearnThrive platform, Cirquon, PiStation.
const order = ['learnthrive-platform', 'cirquon', 'pistation'];
featured.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container section-grid">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
      <p>Open a case study for what it is, my role, the stack and the outcome.</p>
    </div>
    <div>
      <div class="cases">
        {
          featured.map((e) => (
            <details class="case" id={`case-${e.id}`}>
              <summary>
                <div>
                  <h3 class="case-title">{e.title}</h3>
                  <p class="case-sub">
                    {orgLine(e)}
                    {e.period ? <span class="mono"> · {e.period}</span> : null}
                  </p>
                </div>
                <span class="case-open" aria-hidden="true">
                  <svg class="icon" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
                <p class="case-sum">{e.summary}</p>
              </summary>
              <div class="case-body">
                {e.caseStudy && (
                  <dl>
                    <dt>What it is</dt>
                    <dd>{e.caseStudy.what}</dd>
                    <dt>My role</dt>
                    <dd>{e.caseStudy.role}</dd>
                    <dt>Stack</dt>
                    <dd>
                      <ul class="tags">
                        {tagsFor(e).map((t) => (
                          <li>
                            {t.skillId ? (
                              <a class="tag" href={`#skills/${t.skillId}`}>
                                {t.label}
                              </a>
                            ) : (
                              <span class="tag">{t.label}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </dd>
                    <dt>Outcome</dt>
                    <dd>{e.caseStudy.outcome}</dd>
                  </dl>
                )}
                {e.highlights.length > 0 && (
                  <ul class="bullets">
                    {e.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
                {e.links.length > 0 && (
                  <div class="link-row">
                    {e.links.map((l) => (
                      <a class="text-link" href={l.href}>
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </details>
          ))
        }
      </div>

      <h3 class="subhead">University projects</h3>
      <div class="cases">
        {
          others.map((e) => (
            <details class="case" id={`case-${e.id}`}>
              <summary>
                <div>
                  <h4 class="case-title" style="font-size:var(--step-1)">
                    {e.title}
                  </h4>
                </div>
                <span class="case-open" aria-hidden="true">
                  <svg class="icon" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
                <p class="case-sum">{e.summary}</p>
              </summary>
              <div class="case-body">
                {e.highlights.length > 0 && (
                  <ul class="bullets">
                    {e.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
                <ul class="tags">
                  {tagsFor(e).map((t) => (
                    <li>
                      <a class="tag" href={`#skills/${t.skillId}`}>
                        {t.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Deep links: #case-<id> opens that case study.
  const openFromHash = () => {
    const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
