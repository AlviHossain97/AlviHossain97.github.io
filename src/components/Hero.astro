---
import { cv } from '../data/cv';

const pdf = `/${cv.site.pdfFile}`;
// Split the name into words and letters for the reveal. The heading keeps one accessible name.
const words = cv.person.name.split(' ');
let n = 0;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-inner">
      <h1 id="hero-title" class="hero-name" aria-label={cv.person.name}>
        <span aria-hidden="true">
          {words.map((w, wi) => (
            <Fragment>
              {wi > 0 && ' '}
              <span class="w">
                {[...w].map((ch) => (
                  <span class="c" style={`--i:${n++}`}>
                    {ch}
                  </span>
                ))}
              </span>
            </Fragment>
          ))}
        </span>
      </h1>
      <p class="hero-role">{cv.person.headline}</p>
      <p class="hero-lede">{cv.person.lede}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={pdf} download data-magnetic>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"></path>
          </svg>
          Download CV (PDF)
        </a>
        <a class="btn" href={cv.contact.github.href} rel="me" data-magnetic>
          GitHub
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9"></path>
          </svg>
        </a>
        <a class="btn" href={cv.contact.linkedin.href} rel="me" data-magnetic>
          LinkedIn
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9"></path>
          </svg>
        </a>
        <a class="btn" href={`mailto:${cv.contact.email}`} data-magnetic>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6h16v12H4zM4 7l8 6 8-6"></path>
          </svg>
          Email
        </a>
      </div>
    </div>
  </div>
</section>
