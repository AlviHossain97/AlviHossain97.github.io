---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/print.css';
import { cv } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: boolean;
}
const { title = cv.site.title, description = cv.site.description, noindex = false, jsonLd = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.person.name,
  url: cv.site.url,
  jobTitle: cv.person.headline,
  description,
  email: `mailto:${cv.contact.email}`,
  worksFor: { '@type': 'Organization', name: 'LearnThrive Tuition' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Roehampton' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Queen Mary University of London' },
  sameAs: [cv.contact.linkedin.href, cv.contact.github.href],
  knowsAbout: cv.skills.map((s) => s.name),
};
---

<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0f15" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={cv.person.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${cv.person.name}: ${cv.person.positioning.join(', ')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.remove('no-js');
        let t = null;
        try {
          t = localStorage.getItem('theme');
        } catch {
          /* storage blocked: fall back to the OS preference */
        }
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = t;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', t === 'light' ? '#fbfaf7' : '#0b0f15');
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const meta = document.querySelector('meta[name="theme-color"]');
      const apply = (t: 'light' | 'dark') => {
        root.dataset.theme = t;
        meta?.setAttribute('content', t === 'light' ? '#fbfaf7' : '#0b0f15');
        btn?.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
      };
      apply(root.dataset.theme === 'light' ? 'light' : 'dark');
      btn?.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        apply(next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* storage unavailable: theme still applies for this visit */
        }
      });
      // Follow the OS when the visitor has not chosen a theme.
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
        let stored: string | null = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* ignore */
        }
        if (!stored) apply(e.matches ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
