---
// 1200x630 social card. Screenshotted by scripts/postbuild.mjs into dist/og.png, then removed from dist.
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import { cv } from '../data/cv';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og-card</title>
    <style is:global>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        background: #0a0d18;
        color: rgb(244, 246, 251);
        font-family: 'Geist Variable', sans-serif;
        overflow: hidden;
      }
      .card {
        position: relative;
        box-sizing: border-box;
        width: 1200px;
        height: 630px;
        padding: 72px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background-image:
          radial-gradient(60% 80% at 92% 8%, rgba(34, 200, 235, 0.38), transparent 70%),
          radial-gradient(55% 70% at 100% 100%, rgba(140, 90, 245, 0.4), transparent 70%),
          linear-gradient(rgba(150, 190, 255, 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(150, 190, 255, 0.07) 1px, transparent 1px);
        background-size:
          auto,
          auto,
          56px 56px,
          56px 56px;
      }
      h1 {
        margin: 0;
        font-family: 'Bricolage Grotesque Variable', sans-serif;
        font-size: 128px;
        line-height: 1;
        letter-spacing: -0.035em;
        font-weight: 700;
      }
      ul {
        margin: 36px 0 0;
        padding: 0;
        list-style: none;
        font-size: 36px;
        line-height: 1.35;
        color: #c9ced8;
      }
      li::before {
        content: '';
        display: inline-block;
        width: 10px;
        height: 10px;
        margin-right: 18px;
        border-radius: 50%;
        background: linear-gradient(135deg, #43dcf2, #9b6cff);
        vertical-align: middle;
      }
      .foot {
        font-family: 'Geist Mono Variable', monospace;
        font-size: 26px;
        color: #8d95a3;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div>
        <h1>{cv.person.name}</h1>
        <ul>
          {cv.person.positioning.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
      <div class="foot">alvihossain97.github.io</div>
    </div>
  </body>
</html>
